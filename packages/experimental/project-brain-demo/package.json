{
  "name": "@deepseek-ai/dsh-experimental-project-brain-demo",
  "description": "Deterministic tool-free model and scenario data for the Project Brain demo preset",
  "version": "0.1.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
